# Copia este archivo como .env.local para personalizarlo (no se versiona).
# Solo las variables con prefijo VITE_ se exponen al código del navegador:
# nunca pongas secretos aquí.

# Vacío: /api usa el mismo dominio de la página. Vite lo reenvía a FastAPI en
# http://127.0.0.1:8000; funciona en localhost y a través del túnel de Cloudflare.
# En producción, el servidor que publique el build debe enrutar /api al backend.
# Solo configura una URL absoluta si publicas la API en otro origen; en ese caso,
# autoriza el origen del frontend en TERRALAB_CORS_ORIGINS (development).
VITE_API_BASE_URL=

# Mapa base (opcional). Por defecto: estilo vectorial de OpenFreeMap (datos © OpenStreetMap,
# ODbL) y mosaico Sentinel-2 cloudless 2016 de EOX (CC BY 4.0). Cambiar de proveedor no
# requiere tocar el código; mantén siempre visible la atribución que exija el nuevo proveedor.
# VITE_BASEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# VITE_SATELLITE_TILES_URL=https://tiles.maps.eox.at/wmts/1.0.0/s2cloudless_3857/default/g/{z}/{y}/{x}.jpg
