# Reglas generales del monorepo (aplican en todas las subcarpetas).
# Las reglas propias de cada proyecto viven en simulacion/.gitignore y raiz-hackaton/.gitignore.

# Sistema
.DS_Store
Thumbs.db
desktop.ini

# Editores
.idea/
.vscode/*
!.vscode/extensions.json
.claude/settings.local.json

# Variables de entorno locales (los .env.example sí se versionan)
.env
.env.*
!.env.example

# Dependencias y entornos (en cualquier carpeta)
node_modules/
.venv/
.venv-*/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# TypeScript
*.tsbuildinfo

# Logs
*.log
npm-debug.log*

# Autorización del productor: evidencia privada, fuera del código y del sitio público.
content/p6/permiso_productor.png
