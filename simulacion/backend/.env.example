# Copia este archivo como backend/.env para personalizarlo (no se versiona).
# Todas las variables usan el prefijo TERRALAB_.

# Entorno de ejecución: development | test | production
TERRALAB_ENVIRONMENT=development

# Orígenes permitidos por CORS, separados por comas. Solo se aplican en
# development; en otros entornos CORS está desactivado. Si se deja vacío en
# development, se permiten los servidores locales de Vite: dev (puerto 5173) y
# preview (puerto 4173), tanto en localhost como en 127.0.0.1.
TERRALAB_CORS_ORIGINS=

# Búsqueda geográfica: geonames (nomenclátor local, por defecto) | nominatim | disabled.
# geonames necesita generar antes el nomenclátor con `make geodata` (descarga ≈ 14 MB de GeoNames).
TERRALAB_GEOCODER=geonames

# Nominatim (OpenStreetMap) solo debe activarse tras leer y aceptar su política de uso:
# https://operations.osmfoundation.org/policies/nominatim/  (máx. 1 petición/s en total, sin
# autocompletado, User-Agent propio, atribución visible). Requiere un User-Agent que identifique
# la aplicación.
# TERRALAB_GEOCODER=nominatim
# TERRALAB_NOMINATIM_USER_AGENT=
# TERRALAB_NOMINATIM_URL=https://nominatim.openstreetmap.org

# Mundo 3D (fase 04). Caché de rangos COG e instantáneas OSM; `make worlddata` prepara la demo.
# TERRALAB_WORLD_DATA_DIR=data/world
# true: solo caché local, sin peticiones a OpenTopography ni a AWS.
TERRALAB_WORLD_OFFLINE=false
# Elementos OSM para regiones sin instantánea: desactivado. Las instancias públicas de Overpass
# piden no usarse como backend de aplicaciones; configura idealmente una instancia propia.
# TERRALAB_OVERPASS_URL=https://overpass.example.org/api/interpreter
# TERRALAB_OVERPASS_USER_AGENT=
