# Copia este archivo como .env.local para personalizarlo (no se versiona).
# Solo las variables con prefijo VITE_ se exponen al código del navegador:
# nunca pongas secretos aquí.

# URL base de la API de TerraLab (FastAPI). El origen desde el que se sirve el
# frontend (por defecto http://localhost:5173) debe estar permitido en
# TERRALAB_CORS_ORIGINS del backend.
VITE_API_BASE_URL=http://127.0.0.1:8000
# Con «/» la API usa el mismo origen de la página (Vite reenvía /api al backend):
# útil al publicar el 3D por un túnel de Cloudflare.
# VITE_API_BASE_URL=/

# Comparador de rotaciones de Raíz (botón «Comparar rotaciones» de la pantalla inicial).
# En desarrollo (npm run dev) abre el beta-frontend local: http://localhost:5175/.
# En producción, por defecto, el paquete publicado del equipo. Debe ser https
# (se admite http solo para localhost o 127.0.0.1).
# VITE_RAIZ_COMPARADOR_URL=https://morning-violet-efd4.mila-eloc.workers.dev/releases/raiz-oruro-power-20261111-v1/

# Mapa base (opcional). Por defecto: estilo vectorial de OpenFreeMap (datos © OpenStreetMap,
# ODbL) y mosaico Sentinel-2 cloudless 2016 de EOX (CC BY 4.0). Cambiar de proveedor no
# requiere tocar el código; mantén siempre visible la atribución que exija el nuevo proveedor.
# VITE_BASEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# VITE_SATELLITE_TILES_URL=https://tiles.maps.eox.at/wmts/1.0.0/s2cloudless_3857/default/g/{z}/{y}/{x}.jpg
